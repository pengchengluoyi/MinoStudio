# Baked into the renderer at build time. Default is the LAN mDNS name Nexus registers on start.
VITE_NEXUS_URL=http://mino.local:10104
VITE_MINO_CLIENT=studio
# GitHub only. Empty = derive from `git remote get-url origin` (same owner / MinoScout).
# VITE_SCOUT_MANIFEST_URL=https://github.com/<owner>/MinoScout/releases/latest/download/manifest.json
