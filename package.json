{
  "name": "mino-studio",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "description": "Mino Studio — desktop testing workbench",
  "author": "pengchengluoyi@126.com",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && env -u ELECTRON_RUN_AS_NODE vite",
    "dev:web": "vite --mode web --strictPort",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.47.0",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.13.2",
    "dagre": "^0.8.5",
    "echarts": "^6.0.0",
    "electron-updater": "^6.6.2",
    "element-plus": "^2.13.0",
    "jmuxer": "^2.1.0",
    "lucide-vue-next": "^0.554.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.mino.studio",
    "productName": "Mino Studio",
    "icon": "public/icon.ico",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "public/recorder-preload.js",
        "to": "recorder-preload.js"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "public/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "public/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "compression": "normal"
  }
}
